  {
    "id": "churn-model",
    "componentName": "Customer Churn Prediction",
    "category": "AI/ML",
    "sidebarCategory": "ai",
    "year": "2023",
    "livePreviewUrl": "https://github.com",
    "sourceCodeUrl": "https://github.com",
    "techStack": ["PYTHON", "SCIKIT-LEARN", "FASTAPI"],
    "description": "End-to-end machine learning pipeline identifying at-risk users with 94% accuracy.",
    "demoType": "AI_MODEL",
    "demoConfig": {
      "aiModel": {
        "defaultPrompt": "Predict customer retention probability based on subscription metrics and API usage history.",
        "sampleInputs": [
          "Enterprise Plan User, 14 days active/month, 3 support tickets open",
          "Free Tier User, inactive 45 days, 0 billing updates",
          "Pro Tier User, 28 days active/month, high API call volume"
        ],
        "parameters": {
          "confidenceThreshold": 0.85,
          "colorSpace": "RGB_DENSITY",
          "executionMode": "FAST_INFERENCE",
          "temperature": 0.3
        },
        "sampleOutput": {
          "model": "ChurnPredictor_v2.4",
          "status": "ANALYSIS_COMPLETE",
          "risk_score": 0.12,
          "churn_probability": "12.4%",
          "risk_category": "LOW_RISK",
          "key_factors": ["High monthly activity", "Active support resolution", "Stable API usage"]
        },
        "architectureDocs": "Model Architecture: XGBoost Ensemble with Feature Extraction pipeline built on FastAPI. Uses SHAP values for feature importance analysis and latency optimization."
      }
    },
    "systemSpecs": {
      "architecturePipeline": "FastAPI Ingress -> XGBoost Ensemble Model -> Redis Cache -> PostgreSQL Telemetry",
      "apiEndpoint": "POST /api/v1/churn/predict",
      "requestPayload": {
        "user_id": "usr_99812",
        "activity_score": 0.89,
        "support_tickets_30d": 1,
        "plan_type": "ENTERPRISE"
      },
      "responsePayload": {
        "prediction": "RETAINED",
        "churn_probability": 0.058,
        "shap_summary": {
          "top_positive_feature": "api_call_volume",
          "top_negative_feature": "unresolved_tickets"
        }
      },
      "metrics": [
        { "label": "Model Accuracy", "value": "94.2%" },
        { "label": "Inference Latency", "value": "24ms" },
        { "label": "ROC-AUC Score", "value": "0.967" }
      ]
    }
  },
